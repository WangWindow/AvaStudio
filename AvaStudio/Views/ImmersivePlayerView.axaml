<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:vm="using:AvaStudio.ViewModels"
  mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
  x:Class="AvaStudio.Views.ImmersivePlayerView"
  x:DataType="vm:PlayerBarViewModel"
  x:CompileBindings="True">

  <!-- 音频独立播放页：只画封面/标题；退出与播放控制由共享标题栏和底部 Popup 提供。 -->
  <ThemeVariantScope RequestedThemeVariant="Dark">
    <Border Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
      <Viewbox Margin="48,28,48,148"
        Stretch="Uniform"
        StretchDirection="DownOnly"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <StackPanel Width="480" Spacing="0">
          <Border Width="300"
            Height="300"
            CornerRadius="10"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1"
            BoxShadow="0 18 48 0 #73000000">
            <Grid>
              <Image Source="{Binding Artwork}"
                Stretch="UniformToFill"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                IsVisible="{Binding HasArtwork}" />
              <Grid IsVisible="{Binding !HasArtwork}">
                <fi:SymbolIcon Symbol="MusicNote2"
                  FontSize="54"
                  IsVisible="{Binding !IsVideo}"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
                <fi:SymbolIcon Symbol="Video"
                  FontSize="54"
                  IsVisible="{Binding IsVideo}"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>

          <TextBlock Text="{Binding Title}"
            Margin="0,26,0,0"
            MaxWidth="480"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

          <TextBlock Text="{Binding MetaText}"
            Margin="0,8,0,0"
            MaxWidth="440"
            FontSize="13.5"
            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
      </Viewbox>
    </Border>
  </ThemeVariantScope>
</UserControl>
