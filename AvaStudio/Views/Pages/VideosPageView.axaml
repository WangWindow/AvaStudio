<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:pages="using:AvaStudio.ViewModels.Pages"
  xmlns:vm="using:AvaStudio.ViewModels"
  xmlns:items="using:AvaStudio.ViewModels.Items"
  xmlns:controls="using:AvaStudio.Views.Controls"
  mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
  x:Class="AvaStudio.Views.Pages.VideosPageView"
  x:DataType="pages:VideosPageViewModel"
  x:CompileBindings="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://AvaStudio/Styles/PageStyles.axaml" />
    <StyleInclude Source="avares://AvaStudio/Styles/LibraryStyles.axaml" />
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- 16:9 视频卡：封面、标题与时长；整张卡片执行播放。 -->
    <DataTemplate x:Key="VideoCardTemplate" x:DataType="vm:MediaItemViewModel">
      <Button Classes="library-card"
        Width="256"
        Margin="0,0,8,16"
        Command="{Binding PlayCommand}"
        AutomationProperties.Name="{Binding Title}"
        ToolTip.Tip="播放视频">
        <StackPanel>
          <Border Width="240" Height="135" Classes="artwork-frame">
            <Grid>
              <fi:SymbolIcon Symbol="Filmstrip"
                FontSize="32"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
              <Image Source="{Binding Artwork}"
                IsVisible="{Binding HasArtwork}"
                Width="240"
                Height="135"
                Stretch="UniformToFill" />
              <Border Classes="play-badge large">
                <fi:SymbolIcon Symbol="Play"
                  FontSize="16"
                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>

          <TextBlock Classes="card-title" Text="{Binding Title}" Margin="0,8,0,0" />
          <TextBlock Classes="tertiary" Text="{Binding DurationText}" Margin="0,2,0,0" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" Margin="40,24,40,0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
        <TextBlock Classes="page-title" Text="视频" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,4,0,0">
          <Button Classes="page-tab"
            Classes.active="{Binding IsFoldersSelected}"
            Command="{Binding SelectFoldersCommand}"
            AutomationProperties.Name="视频文件夹">
            <StackPanel Spacing="4">
              <TextBlock Text="视频文件夹" Foreground="{Binding $parent[Button].Foreground}" />
              <Border Height="2"
                CornerRadius="1"
                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                IsVisible="{Binding IsFoldersSelected}" />
            </StackPanel>
          </Button>

          <Button Classes="page-tab"
            Classes.active="{Binding IsAllVideosSelected}"
            Command="{Binding SelectAllVideosCommand}"
            AutomationProperties.Name="所有视频">
            <StackPanel Spacing="4">
              <TextBlock Text="所有视频" Foreground="{Binding $parent[Button].Foreground}" />
              <Border Height="2"
                CornerRadius="1"
                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                IsVisible="{Binding IsAllVideosSelected}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <Button Grid.Column="1"
        Classes="page-action"
        Command="{Binding AddVideoFolderCommand}"
        AutomationProperties.Name="添加视频文件夹"
        ToolTip.Tip="添加视频资料库位置">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <fi:SymbolIcon Symbol="FolderAdd" FontSize="15" />
          <TextBlock Classes="header-action-label" Text="添加文件夹" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

    </Grid>

    <!-- 工具行：当前目录名；位于子文件夹时显示返回；右侧为计数与位置摘要。 -->
    <Grid Grid.Row="1" Margin="40,14,40,0" ColumnDefinitions="Auto,*,Auto" MinHeight="32">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsFolderListVisible}">
        <Button Classes="toolbar"
          IsVisible="{Binding IsFolderOpen}"
          Command="{Binding BackToFoldersCommand}"
          AutomationProperties.Name="返回上级文件夹"
          ToolTip.Tip="返回上级文件夹">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fi:SymbolIcon Symbol="ChevronLeft" FontSize="14" />
            <TextBlock Classes="toolbar-label" Text="返回" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <fi:SymbolIcon Symbol="Folder"
          FontSize="14"
          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
          VerticalAlignment="Center" />
        <TextBlock Text="{Binding FolderHeading}"
          FontSize="14"
          FontWeight="SemiBold"
          MaxWidth="320"
          TextTrimming="CharacterEllipsis"
          VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Classes="tertiary" Text="{Binding FolderCountText}" IsVisible="{Binding IsFolderListVisible}" VerticalAlignment="Center" />
        <TextBlock Classes="tertiary" Text="{Binding VideoCountText}" IsVisible="{Binding IsAllVideosSelected}" VerticalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <fi:SymbolIcon Symbol="Library"
            FontSize="13"
            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            VerticalAlignment="Center" />
          <TextBlock Classes="tertiary"
            Text="{Binding LocationSummary}"
            MaxWidth="280"
            TextTrimming="CharacterEllipsis"
            VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- 文件夹分区：当前目录的子文件夹与其直接视频同时显示。 -->
    <Grid Grid.Row="2" IsVisible="{Binding IsFoldersSelected}">
      <Grid IsVisible="{Binding IsFolderListVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="40,12,40,32">
            <ItemsControl ItemsSource="{Binding Folders}"
              IsVisible="{Binding HasFolders}"
              HorizontalAlignment="Stretch">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="items:VideoFolderItemViewModel">
                  <Button Classes="library-card"
                    Width="256"
                    Margin="0,0,8,16"
                    Command="{Binding OpenCommand}"
                    AutomationProperties.Name="{Binding Name}"
                    ToolTip.Tip="打开文件夹">
                    <StackPanel>
                      <Border Width="240" Height="135" Classes="artwork-frame folder-artwork">
                        <fi:SymbolIcon Symbol="Folder"
                          FontSize="44"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>

                      <TextBlock Classes="card-title" Text="{Binding Name}" Margin="0,8,0,0" />
                      <TextBlock Classes="tertiary" Text="{Binding CountText}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 同一目录中的直接视频；与文件夹同时存在时加一个小标题区分。 -->
            <StackPanel IsVisible="{Binding HasFolderVideos}">
              <TextBlock Classes="section-label"
                Text="视频"
                Margin="0,4,0,10"
                IsVisible="{Binding IsFolderOpen}" />
              <ItemsControl ItemsSource="{Binding FolderVideos}"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource VideoCardTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- 所有视频分区。 -->
    <Grid Grid.Row="2" IsVisible="{Binding IsAllVideosSelected}">
      <ScrollViewer IsVisible="{Binding HasAllVideos}"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,12,40,32">
          <ItemsControl ItemsSource="{Binding AllVideos}"
            HorizontalAlignment="Stretch"
            ItemTemplate="{StaticResource VideoCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 空状态：放在最后以确保按钮可点击。 -->
    <controls:EmptyStateView Grid.Row="2"
      IsVisible="{Binding IsEmpty}"
      Margin="40,0,40,32"
      Symbol="{Binding SectionSymbol}"
      Title="{Binding EmptyTitle}"
      Description="{Binding EmptyDescription}"
      PrimaryText="添加文件夹"
      PrimaryIcon="FolderAdd"
      PrimaryCommand="{Binding AddVideoFolderCommand}"
      ShowPrimary="True"
      ShowSecondary="False" />
  </Grid>
</UserControl>

