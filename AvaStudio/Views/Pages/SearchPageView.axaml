<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:AvaStudio.Views.Controls"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:pages="using:AvaStudio.ViewModels.Pages"
  xmlns:vm="using:AvaStudio.ViewModels"
  mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
  x:Class="AvaStudio.Views.Pages.SearchPageView"
  x:DataType="pages:SearchPageViewModel"
  x:CompileBindings="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://AvaStudio/Styles/PageStyles.axaml" />
    <StyleInclude Source="avares://AvaStudio/Styles/ListStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- 页头：标题会带上当前查询，右侧保留资料库设置入口。 -->
    <Grid Grid.Row="0" Margin="40,24,40,0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <TextBlock Classes="page-title"
        Text="{Binding SearchTitle}"
        Margin="0,0,16,0"
        TextTrimming="CharacterEllipsis"
        ToolTip.Tip="{Binding SearchTitle}" />

      <Button Grid.Column="1"
        Classes="page-action"
        VerticalAlignment="Center"
        Command="{Binding OpenLibrarySettingsCommand}"
        AutomationProperties.Name="打开资料库设置"
        ToolTip.Tip="管理资料库位置">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <fi:SymbolIcon Symbol="Library" FontSize="14" />
          <TextBlock Classes="header-action-label" Text="资料库设置" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="divider" Margin="0,16,0,0" />
    </Grid>

    <!-- 初始提示：横向空状态，操作指向资料库设置。搜索输入统一在窗口标题栏。 -->
    <controls:EmptyStateView Grid.Row="1"
      IsVisible="{Binding IsPromptVisible}"
      Margin="40,0,40,32"
      MaxWidth="640"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Symbol="Search"
      Title="搜索资料库"
      Description="输入标题、艺术家或专辑名称，匹配资料库与播放队列中的文件。"
      PrimaryText="管理资料库位置"
      PrimaryIcon="FolderAdd"
      PrimaryCommand="{Binding OpenLibrarySettingsCommand}"
      ShowPrimary="True"
      ShowSecondary="False" />

    <!-- 无结果：说明真实的搜索范围，并提供清除/设置入口。 -->
    <controls:EmptyStateView Grid.Row="1"
      IsVisible="{Binding IsNoResultsVisible}"
      Margin="40,0,40,32"
      MaxWidth="640"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Symbol="SearchInfo"
      Title="{Binding NoResultsTitle}"
      Description="搜索会匹配标题、艺术家和专辑。试试其他关键词，或检查资料库位置。"
      PrimaryText="清除搜索"
      PrimaryIcon="Dismiss"
      PrimaryCommand="{Binding ClearQueryCommand}"
      ShowPrimary="True"
      SecondaryText="管理资料库位置"
      SecondaryIcon="FolderAdd"
      SecondaryCommand="{Binding OpenLibrarySettingsCommand}"
      ShowSecondary="True" />

    <!-- 结果：行本身可播放，末尾播放图标与行按钮是同一个点击区域。 -->
    <Grid Grid.Row="1" IsVisible="{Binding HasResults}" RowDefinitions="Auto,*" Margin="40,24,40,0">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Classes="section-label" Text="搜索结果" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" Classes="tertiary" VerticalAlignment="Center" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,0,24">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MediaItemViewModel">
              <Border Classes="list-row">
                <Button Classes="row-hit"
                  Command="{Binding PlayCommand}"
                  AutomationProperties.Name="{Binding Title}"
                  ToolTip.Tip="播放">
                  <Grid ColumnDefinitions="24,*,Auto,64,28" Height="54">
                    <fi:SymbolIcon Grid.Column="0"
                      Symbol="{Binding KindSymbol}"
                      FontSize="16"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                      Margin="8,0,12,0"
                      VerticalAlignment="Center"
                      Spacing="2">
                      <TextBlock Classes="list-title"
                        Text="{Binding Title}"
                        ToolTip.Tip="{Binding Title}" />
                      <TextBlock Classes="list-subtitle"
                        Text="{Binding Subtitle}"
                        ToolTip.Tip="{Binding Subtitle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Classes="type-pill" Margin="0,0,12,0" HorizontalAlignment="Right">
                      <TextBlock Classes="type-pill-text" Text="{Binding TypeLabel}" />
                    </Border>

                    <TextBlock Grid.Column="3"
                      Classes="list-duration"
                      Text="{Binding DurationText}" />

                    <fi:SymbolIcon Grid.Column="4"
                      Symbol="Play"
                      FontSize="12"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
                  </Grid>
                </Button>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
