<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:chrome="using:Avalonia.Controls.Chrome"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:vm="using:AvaStudio.ViewModels"
  xmlns:views="using:AvaStudio.Views"
  mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
  x:Class="AvaStudio.Views.MainView"
  x:DataType="vm:MainViewModel"
  x:CompileBindings="True">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaStudio/Styles/WindowChromeStyles.axaml" />
    <StyleInclude Source="avares://AvaStudio/Styles/MainViewStyles.axaml" />
  </UserControl.Styles>

  <Grid x:Name="MainRoot" Classes="expanded" ClipToBounds="True">
    <Grid x:Name="ShellGrid" RowDefinitions="32,*,Auto">

      <!-- 内容表面：位于标题栏、导航和内容之下，只给右侧内容区一层比侧边栏更亮的底色。 -->
      <Border x:Name="ContentSurface"
        Grid.Row="0"
        Grid.RowSpan="3"
        ZIndex="0"
        IsHitTestVisible="False" />

      <!-- 透明标题栏：整条透出统一的外壳底色，只承载窗口按钮、搜索和拖动面。 -->
      <Border x:Name="TitleBarStrip" Grid.Row="0" ZIndex="3">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel x:Name="TitleBarLeft"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center"
            IsVisible="{Binding !IsImmersiveOpen}">
            <!-- 顶部栏只保留导航开关；返回历史由 Alt+← 提供，不再占用可见按钮。 -->
            <Button x:Name="NavToggleButton"
              Classes="icon-tool"
              chrome:WindowDecorationProperties.ElementRole="User"
              Click="OnPaneToggleClick"
              AutomationProperties.Name="打开导航菜单"
              ToolTip.Tip="打开导航菜单（Ctrl+E）">
              <fi:SymbolIcon Symbol="Navigation" FontSize="16" />
            </Button>
          </StackPanel>

          <!-- 独立播放页标题栏：音视频共用，只保留退出、媒体图标、片名和窗口按钮。
               退出按钮贴住窗口左边缘并铺满标题栏高度，避免左侧留出死区。 -->
          <StackPanel x:Name="PlayerTitleBarLeft"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0"
            VerticalAlignment="Center"
            IsVisible="{Binding IsImmersiveOpen}">
            <Button x:Name="PlayerTitleBarExitButton"
              Classes="icon-tool immersive-titlebar-exit"
              Command="{Binding PlayerBar.ToggleImmersiveCommand}"
              chrome:WindowDecorationProperties.ElementRole="User"
              AutomationProperties.Name="退出播放页（Esc）"
              ToolTip.Tip="退出播放页（Esc）">
              <fi:SymbolIcon Symbol="ChevronDown" FontSize="18" />
            </Button>

            <fi:SymbolIcon Symbol="MusicNote2"
              FontSize="16"
              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
              VerticalAlignment="Center"
              IsVisible="{Binding IsImmersiveAudio}" />

            <fi:SymbolIcon Symbol="Video"
              FontSize="16"
              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
              VerticalAlignment="Center"
              IsVisible="{Binding IsImmersiveVideo}" />

            <TextBlock Text="{Binding PlayerBar.Title}"
              MaxWidth="520"
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
              TextTrimming="CharacterEllipsis"
              VerticalAlignment="Center" />
          </StackPanel>

          <!-- 中间空白区域是唯一的 Win32 拖动面；搜索胶囊浮在它上面。
               直接放在 Grid 中，避免额外的透明容器覆盖导航面板左上角的返回按钮。 -->
          <Border x:Name="TitleBarDragRegion"
            Grid.Column="1"
            Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="TitleBar"
            DoubleTapped="OnTitleBarDoubleTapped" />

          <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Stretch"
            chrome:WindowDecorationProperties.ElementRole="User">
            <Button x:Name="MinimizeButton"
              Classes="caption"
              chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
              Focusable="False"
              IsTabStop="False"
              Click="OnMinimizeClick"
              AutomationProperties.Name="最小化">
              <Path Width="10" Height="10"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1"
                Data="M0.5,5.5 L9.5,5.5" />
            </Button>

            <Button x:Name="MaximizeButton"
              Classes="caption"
              chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
              Focusable="False"
              IsTabStop="False"
              Click="OnMaximizeClick"
              AutomationProperties.Name="最大化">
              <Path x:Name="MaximizeGlyph"
                Width="10"
                Height="10"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1"
                Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
            </Button>

            <Button x:Name="CloseButton"
              Classes="caption close"
              chrome:WindowDecorationProperties.ElementRole="CloseButton"
              Focusable="False"
              IsTabStop="False"
              Click="OnCloseClick"
              AutomationProperties.Name="关闭">
              <Path Width="10" Height="10"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1"
                Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
            </Button>
          </StackPanel>

          <!-- 标题栏搜索：Windows 11 设置式的居中胶囊。展开/紧凑模式横跨整条标题栏居中，
               窄屏回到导航汉堡与右侧窗口按钮之间的中间列。标记为 User，避免被拖动面吞掉。 -->
          <Border x:Name="TitleBarSearchHost"
            ZIndex="1"
            Height="26"
            MinWidth="140"
            MaxWidth="520"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            CornerRadius="13"
            chrome:WindowDecorationProperties.ElementRole="User"
            ToolTip.Tip="搜索（Ctrl+F）">
            <Grid ClipToBounds="True">
              <TextBox x:Name="SearchBox"
                Classes="titlebar-search"
                Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="搜索"
                AutomationProperties.Name="搜索"
                KeyDown="OnSearchBoxKeyDown" />

              <fi:SymbolIcon Symbol="Search"
                FontSize="13"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="11,0,0,0"
                IsHitTestVisible="False" />

              <!-- 键盘聚焦时显示 Windows 11 风格的强调色下划线。 -->
              <Border x:Name="SearchFocusUnderline"
                Height="2"
                Margin="14,0"
                CornerRadius="1"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- 导航面板贯穿标题栏、内容与底栏行，作为整个外壳的左侧表面；
           顶部汉堡按钮已移到标题栏，列表用 48 DIP 顶部留白避开标题栏。 -->
      <Border x:Name="NavPanel"
        Grid.Row="0"
        Grid.RowSpan="3"
        ZIndex="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch">
        <Grid RowDefinitions="*,Auto">
          <!-- 仅背景层：acrylic 模式下降低不透明度，让原生材质透出；内容层保持完整亮度。 -->
          <Border x:Name="NavPanelBackdrop"
            Grid.RowSpan="2"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            IsHitTestVisible="False" />

          <ListBox x:Name="NavigationList"
            Grid.Row="0"
            Classes="nav-list"
            ItemsSource="{Binding NavigationItems}"
            SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
            AutomationProperties.Name="主导航"
            KeyDown="OnNavigationListKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <StackPanel>
                  <!-- 分组分隔线画在选中填充之外，避免选中时被填充包住。 -->
                  <Border x:Name="NavSeparator"
                    Height="1"
                    Margin="12,7"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    IsVisible="{Binding ShowSeparator}" />

                  <Border x:Name="NavItemSurface"
                    Height="40"
                    CornerRadius="4"
                    ToolTip.Tip="{Binding Label}"
                    Background="{Binding $parent[ListBoxItem].Background}"
                    BorderBrush="{Binding $parent[ListBoxItem].BorderBrush}"
                    BorderThickness="{Binding $parent[ListBoxItem].BorderThickness}">
                    <Grid ColumnDefinitions="3,32,*" AutomationProperties.Name="{Binding Label}">
                      <Border x:Name="NavActiveIndicator"
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                        VerticalAlignment="Center" />
                      <Border x:Name="NavIconHost"
                        Grid.Column="1"
                        Width="32"
                        HorizontalAlignment="Left">
                        <fi:SymbolIcon Symbol="{Binding Icon}"
                          FontSize="16"
                          Foreground="{Binding $parent[ListBoxItem].Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>
                      <TextBlock x:Name="NavLabel"
                        Classes="nav-label"
                        Grid.Column="2"
                        Text="{Binding Label}"
                        Margin="2,0,8,0"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="1" x:Name="PaneFooter">
            <Border Classes="divider" Margin="0,0,0,8" />
            <Button x:Name="SettingsNavButton"
              Classes="nav-footer"
              Classes.active="{Binding IsSettingsSelected}"
              Command="{Binding OpenSettingsCommand}"
              AutomationProperties.Name="设置"
              ToolTip.Tip="设置">
              <Grid ColumnDefinitions="3,32,*" Height="40">
                <Border x:Name="SettingsIndicator"
                  Width="3"
                  Height="16"
                  CornerRadius="1.5"
                  Background="{DynamicResource SystemControlHighlightAccentBrush}"
                  IsVisible="{Binding IsSettingsSelected}"
                  VerticalAlignment="Center" />
                <Border x:Name="SettingsIconHost"
                  Grid.Column="1"
                  Width="32"
                  HorizontalAlignment="Left">
                  <fi:SymbolIcon Symbol="Settings"
                    FontSize="16"
                    Foreground="{Binding $parent[Button].Foreground}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SettingsLabel"
                  Classes="nav-label"
                  Grid.Column="2"
                  Text="设置"
                  Margin="2,0,8,0"
                  VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" x:Name="BodyRoot" ClipToBounds="False">
        <Grid x:Name="ContentHost" ZIndex="0" Background="Transparent" ClipToBounds="True">
          <!-- 缓存的页面视图层：每个页面只创建一次，切换时只改可见性。 -->
          <Grid x:Name="PageLayer" ZIndex="0" Background="Transparent" />

          <!-- libmpv render API 视频表面：始终留在可视树中（只改尺寸，不隐藏），
               这样渲染上下文和位图可以复用。默认缩到右下角 1×1。 -->
          <ContentControl x:Name="VideoHost"
            ZIndex="3"
            Width="1"
            Height="1"
            Background="Black"
            ClipToBounds="True"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False" />

          <!-- 音频沉浸层：覆盖内容区；淡入/缩放由 code-behind 控制。 -->
          <Border x:Name="ImmersiveLayer"
            ZIndex="4"
            IsVisible="False"
            Background="Transparent"
            ClipToBounds="True">
            <views:ImmersivePlayerView DataContext="{Binding PlayerBar}" />
          </Border>

          <!-- 独立播放页控制条：直接叠在视频原生表面/音频封面上方，锚定底部并横向铺满。
               背景保持透明，显隐与命中测试由 code-behind 的自动隐藏逻辑控制。 -->
          <Grid x:Name="PlayerControlsHost"
            ZIndex="5"
            IsVisible="{Binding IsImmersiveOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">
            <views:VideoStageControlsView x:Name="PlayerControlsView" DataContext="{Binding PlayerBar}" />
          </Grid>
        </Grid>

        <!-- 纯命中层：只负责点击内容关闭抽屉，不参与按钮模板，因此没有悬浮/按下变色。 -->
        <Border x:Name="NavigationScrim"
          ZIndex="1"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          PointerPressed="OnNavigationScrimPointerPressed"
          AutomationProperties.Name="关闭导航" />
      </Grid>

      <Grid Grid.Row="2" x:Name="BottomHost">
        <StackPanel Spacing="8">
          <Border IsVisible="{Binding IsStatusVisible}"
            MinHeight="40"
            Padding="10,0"
            CornerRadius="4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <fi:SymbolIcon Symbol="Info"
                FontSize="14"
                Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                Text="{Binding StatusMessage}"
                Margin="8,0,12,0"
                FontSize="12.5"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
              <HyperlinkButton Grid.Column="2"
                Content="查看播放队列"
                FontSize="12"
                VerticalAlignment="Center"
                IsVisible="{Binding IsStatusQueueActionVisible}"
                Command="{Binding GoToQueueCommand}" />
              <Button Grid.Column="3"
                Classes="icon-tool"
                Width="24"
                Height="24"
                Margin="6,0,0,0"
                Command="{Binding DismissStatusCommand}"
                AutomationProperties.Name="关闭提示"
                ToolTip.Tip="关闭提示">
                <fi:SymbolIcon Symbol="Dismiss" FontSize="10" />
              </Button>
            </Grid>
          </Border>

          <views:PlayerBarView x:Name="MiniPlayerBar" DataContext="{Binding PlayerBar}" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- 无边框窗口的缩放握把；每条边都标记对应的 Win32 非客户区角色。 -->
    <Grid x:Name="ResizeGrips" ZIndex="50">
      <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeW" />
      <Border Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeE" />
      <Border Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Top"
        Margin="0,0,135,0"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeN" />
      <Border Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeS" />
      <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
      <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
      <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
        Background="Transparent"
        chrome:WindowDecorationProperties.ElementRole="ResizeSE" />
    </Grid>

    <Border x:Name="DropOverlay"
      ZIndex="100"
      IsVisible="False"
      Background="Transparent"
      IsHitTestVisible="False">
      <Grid Margin="20">
        <Rectangle Stroke="{DynamicResource SystemControlHighlightAccentBrush}"
          StrokeThickness="2"
          StrokeDashArray="6,4"
          RadiusX="8"
          RadiusY="8" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
          <Border Width="56" Height="56"
            CornerRadius="14"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            HorizontalAlignment="Center">
            <fi:SymbolIcon Symbol="FolderOpen"
              FontSize="24"
              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="松开以添加文件"
            Margin="0,16,0,0"
            FontSize="20"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          <TextBlock Text="视频和音频会加入播放队列"
            Margin="0,6,0,0"
            FontSize="13"
            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

