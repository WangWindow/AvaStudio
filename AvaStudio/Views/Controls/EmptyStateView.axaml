<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:controls="using:AvaStudio.Views.Controls"
  xmlns:converters="using:Avalonia.Data.Converters"
  mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="200"
  x:Class="AvaStudio.Views.Controls.EmptyStateView"
  x:Name="Root"
  x:DataType="controls:EmptyStateView"
  x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="Button.empty-state-action">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- 横向布局：左侧大图标，右侧标题、说明与按钮；整体在内容区居中。 -->
  <Grid MaxWidth="620"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">
    <Grid ColumnDefinitions="Auto,Auto">
      <fi:SymbolIcon Grid.Column="0"
        Symbol="{Binding #Root.Symbol}"
        FontSize="104"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />

      <StackPanel Grid.Column="1"
        Margin="32,0,0,0"
        MaxWidth="400"
        VerticalAlignment="Center">
        <TextBlock Text="{Binding #Root.Title}"
          MaxWidth="380"
          FontSize="20"
          FontWeight="SemiBold"
          LineHeight="26"
          TextWrapping="Wrap"
          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

        <TextBlock Text="{Binding #Root.Description}"
          Margin="0,8,0,0"
          MaxWidth="380"
          FontSize="14"
          LineHeight="22"
          TextWrapping="Wrap"
          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,18,0,0">
          <Button Classes="accent empty-state-action"
            IsVisible="{Binding #Root.ShowPrimary}"
            Command="{Binding #Root.PrimaryCommand}"
            AutomationProperties.Name="{Binding #Root.PrimaryText}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <fi:SymbolIcon Symbol="{Binding #Root.PrimaryIcon}"
                FontSize="14"
                IsVisible="{Binding #Root.PrimaryIcon, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding #Root.PrimaryText}"
                VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="empty-state-action"
            IsVisible="{Binding #Root.ShowSecondary}"
            Command="{Binding #Root.SecondaryCommand}"
            AutomationProperties.Name="{Binding #Root.SecondaryText}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <fi:SymbolIcon Symbol="{Binding #Root.SecondaryIcon}"
                FontSize="14"
                IsVisible="{Binding #Root.SecondaryIcon, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding #Root.SecondaryText}"
                VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
