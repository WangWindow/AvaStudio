<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:vm="using:AvaStudio.ViewModels"
  mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="120"
  x:Class="AvaStudio.Views.VideoStageControlsView"
  x:DataType="vm:PlayerBarViewModel"
  x:CompileBindings="True"
  Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaStudio/Styles/PlayerStyles.axaml" />
  </UserControl.Styles>

  <!-- 独立播放页控制条直接覆盖在视频/封面上，背景透明；
       深色作用域让图标、时间和滑杆在明亮画面上仍然清晰。 -->
  <ThemeVariantScope RequestedThemeVariant="Dark">
    <Grid Margin="48,14,48,16"
      RowDefinitions="Auto,Auto"
      RowSpacing="4">

      <!-- 进度：拖动期间由 code-behind 冻结回写，松开只提交一次定位。 -->
      <Slider x:Name="ProgressSlider"
        Classes="player-slider player-progress"
        Template="{StaticResource PlayerSliderTemplate}"
        Minimum="0"
        Maximum="{Binding Duration, Mode=OneWay}"
        Focusable="False"
        IsTabStop="False"
        AutomationProperties.Name="播放进度" />

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="player-icon immersive"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding PreviousCommand}"
            AutomationProperties.Name="上一个"
            ToolTip.Tip="上一个">
            <fi:SymbolIcon Symbol="Previous" FontSize="16" />
          </Button>

          <Button Classes="player-icon player-play immersive"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding TogglePlayPauseCommand}"
            AutomationProperties.Name="{Binding PlayPauseTip}"
            ToolTip.Tip="{Binding PlayPauseTip}">
            <fi:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="20" />
          </Button>

          <Button Classes="player-icon immersive"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding NextCommand}"
            AutomationProperties.Name="下一个"
            ToolTip.Tip="下一个">
            <fi:SymbolIcon Symbol="Next" FontSize="16" />
          </Button>

          <StackPanel Orientation="Horizontal"
            Margin="12,0,0,0"
            VerticalAlignment="Center">
            <TextBlock Classes="player-time immersive" Text="{Binding PositionText}" />
            <TextBlock Classes="player-time immersive" Text=" / " />
            <TextBlock Classes="player-time immersive" Text="{Binding DurationText}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2"
          Orientation="Horizontal"
          Spacing="2"
          VerticalAlignment="Center">
          <Button Classes="player-icon immersive"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding ToggleMuteCommand}"
            AutomationProperties.Name="静音或取消静音"
            ToolTip.Tip="静音或取消静音">
            <fi:SymbolIcon Symbol="{Binding VolumeSymbol}" FontSize="16" />
          </Button>

          <Slider x:Name="VolumeSlider"
            Classes="player-slider player-volume"
            Template="{StaticResource PlayerSliderTemplate}"
            Minimum="0"
            Maximum="100"
            Value="{Binding Volume, Mode=TwoWay}"
            Width="100"
            Margin="2,0,4,0"
            Focusable="False"
            IsTabStop="False"
            AutomationProperties.Name="音量" />

          <Button Classes="player-icon player-toggle immersive"
            Classes.active="{Binding Shuffle}"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding ToggleShuffleCommand}"
            AutomationProperties.Name="随机播放"
            ToolTip.Tip="随机播放">
            <fi:SymbolIcon Symbol="ArrowShuffle" FontSize="16" />
          </Button>

          <Button Classes="player-icon player-toggle immersive"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding CycleRepeatModeCommand}"
            AutomationProperties.Name="{Binding RepeatTip}"
            ToolTip.Tip="{Binding RepeatTip}">
            <fi:SymbolIcon Symbol="{Binding RepeatSymbol}" FontSize="16" />
          </Button>

          <Button Classes="player-icon immersive"
            Focusable="False"
            IsTabStop="False"
            Command="{Binding ToggleFullscreenCommand}"
            AutomationProperties.Name="{Binding FullscreenTip}"
            ToolTip.Tip="{Binding FullscreenTip}">
            <Grid>
              <fi:SymbolIcon Symbol="FullScreenMaximize"
                FontSize="16"
                IsVisible="{Binding !IsFullscreen}" />
              <fi:SymbolIcon Symbol="FullScreenMinimize"
                FontSize="16"
                IsVisible="{Binding IsFullscreen}" />
            </Grid>
          </Button>

          <Button Classes="player-icon immersive"
            Focusable="False"
            IsTabStop="False"
            AutomationProperties.Name="更多操作"
            ToolTip.Tip="更多操作">
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight">
                <MenuItem Header="停止" Command="{Binding StopCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="17" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </ThemeVariantScope>
</UserControl>
