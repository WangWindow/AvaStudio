<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:fi="using:FluentIcons.Avalonia"
  xmlns:vm="using:AvaStudio.ViewModels"
  mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="126"
  x:Class="AvaStudio.Views.PlayerBarView"
  x:DataType="vm:PlayerBarViewModel"
  x:CompileBindings="True">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaStudio/Styles/PlayerStyles.axaml" />
  </UserControl.Styles>

  <!-- 没有媒体时整块折叠，不占页面高度；有媒体时跟随当前应用主题。 -->
  <Border Classes="player-card" IsVisible="{Binding HasMedia}">
    <Grid ColumnDefinitions="Auto,*">
      <!-- 整块封面可点击进入沉浸；左上角只是非命中提示，不再是独立小按钮。 -->
      <Button x:Name="ExpandButton"
        Classes="player-cover-button"
        VerticalAlignment="Center"
        Command="{Binding ToggleImmersiveCommand}"
        AutomationProperties.Name="展开播放器"
        ToolTip.Tip="展开播放器">
        <Grid>
          <Border Classes="player-cover">
            <Grid>
              <Image Source="{Binding Artwork}"
                Stretch="UniformToFill"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                IsVisible="{Binding HasArtwork}" />
              <Grid IsVisible="{Binding !HasArtwork}">
                <fi:SymbolIcon Symbol="MusicNote2"
                  FontSize="26"
                  IsVisible="{Binding !IsVideo}"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
                <fi:SymbolIcon Symbol="Video"
                  FontSize="26"
                  IsVisible="{Binding IsVideo}"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>

          <Border Classes="cover-hover-overlay" IsHitTestVisible="False" />
        </Grid>
      </Button>

      <Grid Grid.Column="1" Margin="14,0,0,0" RowDefinitions="Auto,*,Auto">
        <!-- 标题行：标题/副标题 + 状态标签。 -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="player-title" Text="{Binding Title}" />
            <TextBlock Classes="player-meta" Text="{Binding MetaText}" />
          </StackPanel>

          <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            Spacing="6"
            Margin="12,0,0,0"
            VerticalAlignment="Center">
            <Border Classes="player-chip" IsVisible="{Binding IsLoading}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <fi:SymbolIcon Symbol="ArrowSync"
                  FontSize="11"
                  Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                  VerticalAlignment="Center" />
                <TextBlock Classes="player-chip-text" Text="正在打开…" />
              </StackPanel>
            </Border>
            <Border Classes="player-chip" IsVisible="{Binding IsVideo}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <fi:SymbolIcon Symbol="Video"
                  FontSize="11"
                  VerticalAlignment="Center" />
                <TextBlock Classes="player-chip-text" Text="视频" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- 进度：Position 的实时值由 code-behind 单向写入滑杆（拖动时不写），
             松开时只提交一次定位，避免和播放位置互相覆盖。 -->
        <Slider x:Name="ProgressSlider"
          Grid.Row="1"
          Classes="player-slider player-progress"
          Template="{StaticResource PlayerSliderTemplate}"
          Minimum="0"
          Maximum="{Binding Duration, Mode=OneWay}"
          AutomationProperties.Name="播放进度" />

        <!-- 传输控制 + 时间 + 右侧工具；没有真实功能的按钮不出现。 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="player-icon"
              Command="{Binding PreviousCommand}"
              AutomationProperties.Name="上一个"
              ToolTip.Tip="上一个">
              <fi:SymbolIcon Symbol="Previous" FontSize="15" />
            </Button>
            <Button Classes="player-icon player-play"
              Command="{Binding TogglePlayPauseCommand}"
              AutomationProperties.Name="{Binding PlayPauseTip}"
              ToolTip.Tip="{Binding PlayPauseTip}">
              <fi:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="17" />
            </Button>
            <Button Classes="player-icon"
              Command="{Binding NextCommand}"
              AutomationProperties.Name="下一个"
              ToolTip.Tip="下一个">
              <fi:SymbolIcon Symbol="Next" FontSize="15" />
            </Button>

            <StackPanel Orientation="Horizontal"
              Margin="10,0,0,0"
              VerticalAlignment="Center">
              <TextBlock Classes="player-time" Text="{Binding PositionText}" />
              <TextBlock Classes="player-time" Text=" / " />
              <TextBlock Classes="player-time" Text="{Binding DurationText}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            Spacing="2"
            VerticalAlignment="Center">
            <Button Classes="player-icon"
              Command="{Binding ToggleMuteCommand}"
              AutomationProperties.Name="静音或取消静音"
              ToolTip.Tip="静音或取消静音">
              <fi:SymbolIcon Symbol="{Binding VolumeSymbol}" FontSize="16" />
            </Button>

            <Slider x:Name="VolumeSlider"
              Classes="player-slider player-volume"
              Template="{StaticResource PlayerSliderTemplate}"
              Minimum="0"
              Maximum="100"
              Value="{Binding Volume, Mode=TwoWay}"
              Margin="0,0,6,0"
              AutomationProperties.Name="音量" />

            <Button Classes="player-icon player-toggle"
              Classes.active="{Binding Shuffle}"
              Command="{Binding ToggleShuffleCommand}"
              AutomationProperties.Name="随机播放"
              ToolTip.Tip="随机播放">
              <fi:SymbolIcon Symbol="ArrowShuffle" FontSize="15" />
            </Button>

            <Button Classes="player-icon player-toggle"
              Command="{Binding CycleRepeatModeCommand}"
              AutomationProperties.Name="{Binding RepeatTip}"
              ToolTip.Tip="{Binding RepeatTip}">
              <fi:SymbolIcon Symbol="{Binding RepeatSymbol}" FontSize="15" />
            </Button>

            <!-- 全屏按钮只请求系统全屏；未进入播放页时由 MainView 先打开播放页。
                 进入播放页仍走左侧封面的独立入口。 -->
            <Button x:Name="FullscreenButton"
              Classes="player-icon"
              Command="{Binding ToggleFullscreenCommand}"
              AutomationProperties.Name="{Binding FullscreenTip}"
              ToolTip.Tip="{Binding FullscreenTip}">
              <Grid>
                <fi:SymbolIcon Symbol="FullScreenMaximize"
                  FontSize="15"
                  IsVisible="{Binding !IsFullscreen}" />
                <fi:SymbolIcon Symbol="FullScreenMinimize"
                  FontSize="15"
                  IsVisible="{Binding IsFullscreen}" />
              </Grid>
            </Button>

            <Button x:Name="MoreButton"
              Classes="player-icon"
              AutomationProperties.Name="更多操作"
              ToolTip.Tip="更多操作">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight">
                  <MenuItem Header="停止" Command="{Binding StopCommand}" />
                </MenuFlyout>
              </Button.Flyout>
              <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
