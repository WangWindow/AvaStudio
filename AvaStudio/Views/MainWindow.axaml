<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:AvaStudio.ViewModels"
  xmlns:views="using:AvaStudio.Views"
  mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
  x:Class="AvaStudio.Views.MainWindow"
  x:DataType="vm:MainViewModel"
  Icon="/Assets/Icon.ico"
  Title="{Binding WindowTitle}"
  Width="1200"
  Height="720"
  MinWidth="540"
  MinHeight="480"
  WindowStartupLocation="CenterScreen"
  ExtendClientAreaToDecorationsHint="True"
  WindowDecorations="None"
  Background="Transparent"
  TransparencyBackgroundFallback="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
  <views:MainView />
</Window>
