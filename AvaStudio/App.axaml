<Application xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:AvaStudio"
  x:Class="AvaStudio.App"
  RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AvaStudio/Styles/PlayerSliderResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaStudio/Styles/AppFoundation.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/logo-tray-light.png"
        ToolTipText="AvaStudio"
        Clicked="OnPlayPauseClick">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="显示窗口"
              Click="OnShowWindowClick" />
            <NativeMenuItem Header="轻量模式"
              ToggleType="CheckBox"
              Click="OnLightweightModeClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="上一首"
              Click="OnPreviousTrackClick" />
            <NativeMenuItem Header="播放 / 暂停"
              Click="OnPlayPauseClick" />
            <NativeMenuItem Header="下一首"
              Click="OnNextTrackClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="退出"
              Click="OnExitClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

</Application>
